+                self.commands += 1;
+            }
+        }
+        let mut parser = Parser::<1024>::default();
+        let mut sink = Sink::default();
+        parser.advance(&mut sink, b"\x1b]6;");
+        let capacity = parser.osc_raw.capacity();
+        for _ in 0..16 {
+            parser.advance(&mut sink, &[b'x'; 65536]);
